<!DOCTYPE html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <title><%= headTitle %></title>
    <link rel="stylesheet" href="/css/main.css" />
  </head>
  <body>
    <main>
      <!-- Navigation -->
      <%- include('partials/navigation', { menuLinks: menuLinks, activeLinkPath: activeLinkPath }); %>
      
      <h1 class="heading">Produkty</h1>

      <% if (products && products.length) { %>
        <ul class="products-list">
          <% products.forEach((product) => { %>
            <li>
              <%- include('partials/card', { product: product }) %>
            </li>
          <% }); %>
        </ul>
      <% } else { %>
        <p>Brak produktów do wyświetlenia.</p>
      <% } %>
    </main>

    <script>
      function deleteProduct(name) {
        if (!confirm(`Czy na pewno chcesz usunąć produkt ${name}?`)) {
          return;
        }

        fetch(`/products/${encodeURIComponent(name)}`, {
          method: "DELETE",
        }).then((response) => {
          if (response.ok) {
            window.location.reload();
          } else {
            alert("Wystąpił błąd podczas usuwania produktu.");
          }
        });
      }
    </script>
  </body>
</html>

